# Скопируй этот файл в .env (он в .gitignore) и заполни значения.
# Никогда не коммить .env и не отправляй его содержимое в чаты.

# Токен от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=

# Ключ Claude API (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Токен Telegraph: создаётся командой `python -m tools.publish_telegraph init`
TELEGRAPH_TOKEN=

# Локально из России Telegram и Anthropic доступны через прокси; на сервере оставь пустым
PROXY_URL=

DATABASE_URL=sqlite+aiosqlite:///data/bot.sqlite3

# Модели для разбора открытых ответов: пробные разборы, купленные, админские
MODEL_FREE=claude-haiku-4-5
MODEL_PAID=claude-sonnet-5
MODEL_ADMIN=claude-sonnet-5

# Сколько пробных разборов получает каждый ученик (один раз, не в сутки)
TRIAL_REVIEWS=15

# Пакеты разборов: "разборов:рублей:звёзд" через запятую
PACKS=50:99:75,350:490:450

# Имя бота без @ (для ссылки возврата после оплаты)
BOT_USERNAME=hopbyhop_bot

# Касса Platega (оплата картой и СБП): Настройки проекта -> MerchantId и API-ключ.
# Если пусто, в боте остаётся только оплата звёздами Telegram.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Номер способа оплаты в Platega (2 - СБП, 11 - карты); пусто - плательщик выбирает сам
PLATEGA_PAYMENT_METHOD=

# Предупредить админов, когда расчётный остаток бюджета API ниже этой суммы, $
BUDGET_ALERT_USD=5

# Доля правильных ответов, чтобы тест считался пройденным
QUIZ_PASS_RATIO=0.8
